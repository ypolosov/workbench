#!/bin/sh
# workbench command: connects the personal base of this machine to projects.
# install.sh puts a launcher for it into ~/.local/bin (or --bin-dir).
set -eu

WB_DIR="$(cd "$(dirname "$0")/.." && pwd -P)"
WB_DISPLAY_DIR=$WB_DIR
if command -v cygpath >/dev/null 2>&1; then WB_DISPLAY_DIR="$(cygpath -m "$WB_DIR")"; fi

# shellcheck source=/dev/null
[ ! -f "$WB_DIR/.runtime/env.sh" ] || . "$WB_DIR/.runtime/env.sh"

usage() {
  cat <<EOF
workbench - личная база этой машины: $WB_DISPLAY_DIR

  workbench attach --user       подключить инструкции и память базы ко всем проектам этой машины:
                                блоки в пользовательских CLAUDE.md (Claude Code) и AGENTS.md (Codex)
  workbench detach --user       убрать эти блоки; свой текст файлов остаётся
  workbench attach [<проект>]   подключить хуки и скиллы базы к проекту для Claude Code, Codex
                                и Cursor (по умолчанию - к текущему)
  workbench detach [<проект>]   отключить базу от проекта; сама база остаётся
  workbench setup               заново подготовить базу: издание FPF, проверки git и файлы агентов
                                в самой базе (после git pull или после переноса папки)
  workbench doctor              проверить готовность базы, команды, подключений и хуков
  workbench location            показать каталог ваших личных материалов workbench
  workbench help                эта справка

Синхронизация с другими машинами: git -C "$WB_DISPLAY_DIR" pull, затем push.
Обновления шаблона: git -C "$WB_DISPLAY_DIR" pull template main.
EOF
}

command="${1:-help}"
[ $# -eq 0 ] || shift
case $command in
  attach) exec sh "$WB_DIR/scripts/attach.sh" "$@" ;;
  detach) exec sh "$WB_DIR/scripts/attach.sh" --detach "$@" ;;
  setup) exec sh "$WB_DIR/scripts/setup.sh" "$@" ;;
  doctor) exec sh "$WB_DIR/scripts/doctor.sh" "$@" ;;
  location) printf '%s\n' "$WB_DISPLAY_DIR" ;;
  help | -h | --help) usage ;;
  *)
    echo "workbench: неизвестная команда: $command (см. workbench help)" >&2
    exit 1
    ;;
esac
