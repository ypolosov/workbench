#!/bin/sh
# Blocks commits that carry company markers or obvious secrets into the personal core.
# Markers live in .git/info/company-markers (local, untracked), one word or regex per line.
set -u
markers="$(git rev-parse --git-common-dir)/info/company-markers"
added="$(git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' || true)"
[ -z "$added" ] && exit 0

fail=0
if [ -f "$markers" ]; then
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    case "$m" in \#*) continue ;; esac
    if printf '%s\n' "$added" | grep -qiE -- "$m"; then
      echo "pre-commit: company marker found in staged changes: $m" >&2
      fail=1
    fi
  done <"$markers"
else
  echo "pre-commit: no marker list at $markers - company check skipped" >&2
fi

secret_re='(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36,}|sk-ant-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,})'
if printf '%s\n' "$added" | grep -qE -- "$secret_re"; then
  echo "pre-commit: something that looks like a secret is staged" >&2
  fail=1
fi

[ "$fail" = 0 ] || {
  echo "pre-commit: commit blocked (personal core must not hold company data or secrets)" >&2
  exit 1
}
exit 0
