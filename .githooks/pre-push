#!/bin/sh
# Blocks non-fast-forward pushes, so that no agent overwrites the shared history of
# the personal base. Adapted from FMT-exocortex-template .githooks/pre-push (MIT,
# Tseren Tserenov). Override, only by the owner: ALLOW_FORCE_PUSH=1 git push --force
set -u

[ -n "${ALLOW_FORCE_PUSH:-}" ] && exit 0

zero=0000000000000000000000000000000000000000
while read -r _ local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  [ "$remote_sha" = "$zero" ] && continue
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo ""
    echo "Push blocked: $remote_ref is not a fast-forward."
    echo "   This overwrites history and may destroy parallel agent work."
    echo "   Override (if authorized): ALLOW_FORCE_PUSH=1 git push --force"
    exit 1
  fi
done

exit 0
