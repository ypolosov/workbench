{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/adapters/claude/hooks/session-start.sh\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/adapters/claude/hooks/wp-gate-reminder.sh\"" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/adapters/claude/hooks/close-gate-reminder.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/adapters/claude/hooks/destructive-guard.sh\"" }
        ]
      }
    ]
  }
}
